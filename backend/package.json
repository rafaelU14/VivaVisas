{
  "name": "backend",
  "version": "1.0.0",
  "description": "Backend API for VivaVisas",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "typeorm": "node ./node_modules/typeorm/cli.js",
    "migration:run": "node ./node_modules/typeorm/cli.js migration:run -d src/infrastructure/database/data-source.js",
    "migration:revert": "node ./node_modules/typeorm/cli.js migration:revert -d src/infrastructure/database/data-source.js",
    "migration:show": "node ./node_modules/typeorm/cli.js migration:show -d src/infrastructure/database/data-source.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "nodemailer": "^10.5.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.1.2",
    "zod": "^4.6.7"
  }
}
